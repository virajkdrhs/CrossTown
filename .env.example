# Copy to .env and fill in. .env is gitignored - never commit real credentials.

# --- PostGIS (optional) -------------------------------------------------------
# Leave these unset to run the API straight off the processed GeoJSON files in
# Data/Processed. Set a password to use the PostGIS tables instead.
# CROSSTOWN_DB_PASSWORD=your_local_postgres_password
# CROSSTOWN_DB_USER=postgres
# CROSSTOWN_DB_HOST=localhost
# CROSSTOWN_DB_PORT=5432
# CROSSTOWN_DB_NAME=crosstown
# Or supply the whole URL at once:
# CROSSTOWN_DATABASE_URL=postgresql://postgres:password@localhost:5432/crosstown

# --- API ----------------------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser.
# CROSSTOWN_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Pipeline -----------------------------------------------------------------
# Travel-time budget in minutes used to build the access grid.
# CROSSTOWN_TRAVEL_TIME_BUDGET=45
# Departure timestamp for the r5py matrix (ISO 8601).
# CROSSTOWN_DEPARTURE=2026-09-15T08:30
